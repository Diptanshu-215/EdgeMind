# Copy to .env and edit. docker compose reads it automatically.

# This machine's Wi-Fi / hotspot IP (ipconfig -> IPv4 Address). Used for the phone QR code and join command.
HOST_IP=192.168.1.20

# Change these before any real deployment.
JOIN_CODE=EM-2026
ADMIN_TOKEN=change-this-admin-token
OPERATOR_PIN=246810

# Local LLM for AI answers: Ollama running on this machine (default), or any reachable Ollama.
OLLAMA_URL=http://host.docker.internal:11434

# Published ports (defaults 8000 / 8100)
# HUB_PORT=8000
# GATEWAY_PORT=8100
